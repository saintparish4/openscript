{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(WebFetch|WebSearch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/.venv/bin/openscript-hook pre-tool-use || exit 2",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Read|WebFetch|WebSearch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/.venv/bin/openscript-hook post-tool-use",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
