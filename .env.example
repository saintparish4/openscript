# OpenScript environment configuration
# Copy to .env: cp .env.example .env

# Database — matches the docker-compose postgres service defaults
DATABASE_URL=postgresql+asyncpg://openscript:openscript@localhost:5432/openscript

# Server authentication — all protected API endpoints require X-API-KEY: <value>
OPENSCRIPT_API_KEY=changeme

# Logging
OPENSCRIPT_LOG_LEVEL=INFO
OPENSCRIPT_LOG_FORMAT=json
